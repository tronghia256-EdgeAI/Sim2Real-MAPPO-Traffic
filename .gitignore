# =============================================================================
# ML model checkpoints
# Keep:  best_model.pt  run_config.json  models/yolo/yolov11.pt
# Ignore: intermediate checkpoints, legacy weights, and exported model dirs
# =============================================================================
models/**/checkpoint_*.pt
models/**/last_model.pt
models/**/checkpoints/
models/**/*.zip
models/yolo/weights.pt
models/yolo/best_yolo_model.pt
models/yolo/best.pt
models/yolo/*_openvino_model/

# =============================================================================
# Data
# =============================================================================
data/processed/
data/dataset/
data/calibration/
data/calibration.cache

# =============================================================================
# Logs  (keep training CSVs + tfevents; ignore generated media & old SB3 logs)
# =============================================================================
logs/events/*.jpg
logs/events/*.jpeg
logs/events/*.png
logs/PPO_*/
logs/evaluations.npz
logs/system.log
logs/performance.log

# =============================================================================
# Secrets & private configs
# =============================================================================
configs/tele.json

# =============================================================================
# SUMO evaluation — generated route files (large, regenerate via script)
# =============================================================================
sumo_configs/evaluation/*/trips.trips.xml
sumo_configs/evaluation/*/traffic_test.rou.xml
sumo_configs/evaluation/*/traffic_test.rou.alt.xml
sumo_configs/evaluation/*/tripinfo*.xml
sumo_configs/evaluation/*/summary*.xml
*.rou.alt.xml

# =============================================================================
# Ablation & experiment outputs
# =============================================================================
results/paper1_mappo/ablation/
results/paper2_vision/*
results/paper3_sim2real/*
results/figures/

# =============================================================================
# W3-5 benchmark / smoke / campaign-scratch artifacts (never paper data)
# =============================================================================
logs/*_bench*/
models/*_bench*/
logs/ippo_smoke/
models/ippo_smoke/
logs/rl/
models/mappo/20260612_*/
results/paper1_mappo/campaign_smoke/
runs/

# =============================================================================
# Paper-1 checkpoint + training-log archive (relocated 2026-07-07 out of
# results/ into models/ and logs/). Bulk binaries kept as a LOCAL backup only —
# the paper cites eval outputs under results/paper1_mappo/, never these weights.
# =============================================================================
models/paper1_mappo/
logs/paper1_mappo/

# =============================================================================
# Scaled networks (N1/N2/N3): commit topology + lane_groups + sumocfgs;
# demand regenerates deterministically via scripts/generate_demand.py --seed
# (same convention as sumo_configs/evaluation above). tls_actuated.add.xml
# is rebuilt at runtime by experiment/baselines/actuated.py.
# =============================================================================
sumo_configs/networks/*/demand_*.rou.xml
sumo_configs/networks/*/demand_*.trips.xml
sumo_configs/networks/*/tls_actuated.add.xml

# =============================================================================
# Jupyter notebook checkpoints
# =============================================================================
notebooks/.ipynb_checkpoints/
.ipynb_checkpoints/

# =============================================================================
# Tool-specific (not part of the project)
# =============================================================================
.aiignore
NOTES.md
# LaTeX manuscript (kept local / Overleaf only, not on GitHub)
docs/paper1_latex/
