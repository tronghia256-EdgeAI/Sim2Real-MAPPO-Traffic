        ],
        [
          1120,
          380
        ]
      ],
      "camera_frame": "cam_7_frame"
    }
  },
  "features": {
    "lane_features": [
      {
        "index": 0,
        "name": "vehicle_count",
        "description": "Number of actively tracked vehicles in lane",
        "normalization": {
          "type": "min_max",
          "max_value": 20,
          "range": [
            0.0,
            1.0
          ],
          "formula": "clamp(vehicle_count / vehicle_cap, 0, 1)"
        },
        "missing_value": 0.0
      },
      {
        "index": 1,
        "name": "queue_length",
        "description": "Number of stopped/queued vehicles (speed <= stop_speed_px_s)",
        "normalization": {
          "type": "min_max",
          "max_value": 50,
          "range": [
            0.0,
            1.0
          ],
          "formula": "clamp(queue_length / queue_cap, 0, 1)"
        },
        "missing_value": 0.0
      },
      {
        "index": 2,
        "name": "waiting_time",
        "description": "Average waiting time of vehicles in lane (seconds)",
        "normalization": {
          "type": "min_max",
          "max_value": 300,
          "range": [
            0.0,
            1.0
          ],
          "formula": "clamp(avg_waiting_time / waiting_cap, 0, 1)"
        },
        "missing_value": 0.0
      },
      {
        "index": 3,
        "name": "avg_speed",
        "description": "Average speed of vehicles in lane (m/s)",
        "normalization": {
          "type": "min_max",
          "max_value": 15.0,
          "range": [
            0.0,
            1.0
          ],
          "formula": "clamp(avg_speed / speed_cap, 0, 1)"
        },
        "missing_value": 0.0
      },
      {
        "index": 4,
        "name": "occupancy",
        "description": "Fraction of lane occupied by vehicle bboxes",
        "normalization": {
          "type": "clip",
          "range": [
            0.0,
            1.0
          ],
          "formula": "clamp(total_bbox_area / (lane_length_px * lane_width_px), 0, 1)"
        },
        "missing_value": 0.0
      },
      {
        "index": 5,
        "name": "throughput",
        "description": "Number of vehicles exiting lane per second",
        "normalization": {
          "type": "min_max",
          "max_value": 10,
          "range": [
            0.0,
            1.0
          ],
          "formula": "clamp(vehicles_exited_per_sec / throughput_cap, 0, 1)"
        },
        "missing_value": 0.0
      }
    ],
    "tls_features": [
      {
        "index": 0,
        "name": "pressure",
        "description": "Bidirectional pressure: (group_A_vehicle + group_A_queue) - (group_B_vehicle + group_B_queue)",
        "normalization": {
          "type": "tanh",
          "scale": 70.0,
          "range": [
            -1.0,
            1.0
          ],
          "formula": "tanh(raw_pressure / (queue_cap + vehicle_cap))"
        },
        "notes": "Pressure can be negative (preference for other direction). Tanh ensures stable [-1,1] range for training stability."
      },
      {
        "index": 1,
        "name": "phase_id",
        "description": "Current phase of traffic light (0 or 1)",
        "normalization": {
          "type": "one_hot",
          "num_classes": 2,
          "range": [
            0.0,
            1.0
          ]
        },
        "notes": "One-hot encoding: phase_0=[1,0], phase_1=[0,1]. In observation: [phase_one_hot[0]], index 1 is occupied by phase_one_hot[1]"
      },
      {
        "index": 2,
        "name": "time_in_phase",
        "description": "Time elapsed in current phase (seconds)",
        "normalization": {
          "type": "min_max",
          "max_value": 90,
          "range": [
            0.0,
            1.0
          ],
          "formula": "clamp(time_in_phase_sec / max_green_time, 0, 1)"
        },
        "missing_value": 0.0
      },
      {
        "index": 3,
        "name": "accident_flag",
        "description": "Binary indicator of accident/anomaly in TLS lanes (from external detector)",
        "normalization": {
          "type": "binary",
          "range": [
            0.0,
            1.0
          ],
          "formula": "1.0 if accident_detected else 0.0"
        },
        "missing_value": 0.0,
        "notes": "Can be sourced from external anomaly detector or TLS state"
      }
    ]
  },
  "temporal_smoothing": {
    "enabled": true,
    "method": "ema",
    "alpha": 0.3,
    "description": "Exponential Moving Average for smoother state transitions. new_state = alpha * current + (1-alpha) * prev_state",
    "apply_to": [
      "vehicle_count",
      "queue_length",
      "avg_speed",
      "pressure"
    ]
  },
  "roi_association": {
    "primary_method": "polygon_iou",
    "primary_threshold": 0.5,
    "fallback_method": "centroid_inside_polygon",
    "fallback_threshold": null,
    "description": "Primary: compute IoU between detection bbox and lane polygon. If IoU >= 0.5, assign to lane. Fallback: check if detection centroid is inside lane polygon."
  },
  "data_collection": {
    "missing_value_handling": "default_to_zero",
    "nan_handling": "default_to_zero",
    "outlier_clipping": "enabled"
  },
  "training_stability": {
    "observation_normalization": "essential",
    "pressure_range": "[-1, 1]",
    "speed_range": "[0, 1]",
    "occupancy_range": "[0, 1]",
    "notes": "All features must be in valid ranges for stable PPO training"
  },
  "paper_compliance": {
    "lane_based": true,
    "multi_agent": true,
    "bidirectional_pressure": true,
    "temporal_smoothing": true,
    "camera_frame_roi": true,
    "notes": "Configuration suitable for academic publication (Q1/Q2 venues)"
  }
}