{
  "schema_name": "mappo_traffic_control_production",
  "version": "3.1.0",
  "tls_ids": [
    "tls_0",
    "tls_1"
  ],
  "training_tls_ids": [
    "J0",
    "J2"
  ],
  "runtime_to_training_tls": {
    "tls_0": "J0",
    "tls_1": "J2"
  },
  "description": "Production-ready multi-agent MAPPO state schema for YOLO+ByteTrack based intelligent traffic signal control with lane-based observations, bidirectional pressure computation, temporal smoothing, and strict lane ordering.",
  "system_params": {
    "fps": 10,
    "time_delta_sec": 0.1,
    "speed_cap": 15.0,
    "queue_cap": 50,
    "waiting_cap": 300,
    "vehicle_cap": 20,
    "max_green_time": 60,
    "px_per_meter": 20.0,
    "stop_speed_m_s": 0.1,
    "metrics_log_every": 20,
    "throughput_cap": 10,
    "vehicle_detection": {
      "motorbike_class_ids": [
        3
      ],
      "heavy_class_ids": [
        1,
        4
      ],
      "description": "YOLO model class IDs: 0=accident, 1=bus, 2=car, 3=motorcycle, 4=truck"
    },
    "temporal_smoothing": {
      "buffer_ema_alpha": 0.6,
      "description": "EMA smoothing factor [0,1]. 0=no smoothing, 1=no history. Recommended 0.5-0.7"
    }
  },
  "multi_agent": {
    "num_agents": 2,
    "agent_type": "MAPPO",
    "agent_mapping": {
      "agent_0": "tls_0",
      "agent_1": "tls_1"
    },
    "observation_type": "centralized_training_decentralized_execution"
  },
  "traffic_lights": {
    "tls_ids": [
      "tls_0",
      "tls_1"
    ],
    "max_lanes_per_tls": 4
  },
  "controlled_lanes_dict": {
    "tls_0": [
      "lane_0",
      "lane_1",
      "lane_2",
      "lane_3"
    ],
    "tls_1": [
      "lane_4",
      "lane_5",
      "lane_6",
      "lane_7"
    ]
  },
  "vector_layout": {
    "lane_feature_dim": 5,
    "tls_feature_dim": 6,
    "per_agent_observation_dim": 26,
    "global_observation_dim": 52,
    "calculation": "per_agent = max_lanes_per_tls * lane_feature_dim + tls_feature_dim = 4 * 5 + 6 = 26; global = 26 * 2 = 52"
  },
  "phase_action_map": {
    "tls_0": [
      0,
      2
    ],
    "tls_1": [
      0,
      2
    ]
  },
  "ordering_rules": {
    "lane_order_rule": "CRITICAL: Use exact lane order from controlled_lanes_dict. Never reorder lanes. Lane order must match perfectly between training and inference.",
    "padding_rule": "Pad missing lane slots with zeros (0.0) at tail. For tls_0: lanes[0:24], then tls_features[24:28]",
    "truncation_rule": "Keep only first max_lanes_per_tls lanes. If TLS has > 4 lanes, truncate to 4 and warn.",
    "missing_value_rule": "avg_speed=0 if no vehicles; waiting_time=0 if empty; occupancy=0 if empty; throughput=0 if empty"
  },
  "lane_groups": {
    "lane_group_type": "bidirectional_pressure",
    "description": "Two opposing lane groups per TLS. Pressure = (group_A_vehicle_count + group_A_queue_length) - (group_B_vehicle_count + group_B_queue_length)",
    "tls_0": [
      [
        "lane_0",
        "lane_1"
      ],
      [
        "lane_2",
        "lane_3"
      ]
    ],
    "tls_1": [
      [
        "lane_4",
        "lane_5"
      ],
      [
        "lane_6",
        "lane_7"
      ]
    ]
  },
  "lane_definitions": {
