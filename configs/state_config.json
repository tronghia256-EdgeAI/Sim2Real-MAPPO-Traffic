  },
  "features": {
    "_authority_note": "Names/order MUST match DEFAULT_LANE_FEATURE_NAMES + DEFAULT_TLS_FEATURE_NAMES in src/traffic_env/config.py (obs schema 1.2.0). This block is documentation only; no runtime code reads it. Bug D1 fixed 2026-06-15.",
    "lane_features": [
      {
        "index": 0,
        "name": "effective_queue_norm",
        "description": "Length-weighted halted-vehicle queue, normalized by lane length.",
        "normalization": {
          "type": "clip",
          "range": [
            0.0,
            1.0
          ],
          "sumo_source": "sum(halted_vehicle_length) / lane_length (halt threshold 0.1 m/s)",
          "vision_proxy": "sum(CLASS_LEN_M * px_per_meter) / lane_length_px"
        },
        "missing_value": 0.0
      },
      {
        "index": 1,
        "name": "occupancy_norm",
        "description": "1D lane occupancy fraction (vehicle length coverage along the lane).",
        "normalization": {
          "type": "clip",
          "range": [
            0.0,
            1.0
          ],
          "sumo_source": "getLastStepOccupancy() / 100 (1D)",
          "vision_proxy": "sum(vehicle_length_px) / lane_length_px (1D)"
        },
        "missing_value": 0.0
      },
      {
        "index": 2,
        "name": "avg_speed_norm",
        "description": "Mean vehicle speed in lane, normalized by speed_cap.",
        "normalization": {
          "type": "clip",
          "range": [
            0.0,
            1.0
          ],
          "sumo_source": "mean(getSpeed()) / speed_cap",
          "vision_proxy": "mean(ByteTrack delta_pos/delta_t) / speed_cap"
        },
        "missing_value": 0.0
      },
      {
        "index": 3,
        "name": "motorbike_share",
        "description": "Fraction of vehicles that are motorcycles (YOLO class 3).",
        "normalization": {
          "type": "clip",
          "range": [
            0.0,
            1.0
          ],
          "sumo_source": "motorcycle type count / total",
          "vision_proxy": "YOLO cls 3 count / total"
        },
        "missing_value": 0.0
      },
      {
        "index": 4,
        "name": "heavy_vehicle_share",
        "description": "Fraction of vehicles that are buses or trucks (YOLO classes 1+4).",
        "normalization": {
          "type": "clip",
          "range": [
            0.0,
            1.0
          ],
          "sumo_source": "(bus+truck) type count / total",
          "vision_proxy": "YOLO cls (1+4) count / total"
        },
        "missing_value": 0.0
      }
    ],
    "tls_features": [
      {
        "index": 0,
        "name": "phase_one_hot_0",
        "description": "One-hot bit for SUMO phase 0 (Group A green, dirs 0,1).",
        "normalization": {
          "type": "one_hot",
          "range": [
            0.0,
            1.0
          ]
        },
        "missing_value": 0.0
      },
      {
        "index": 1,
        "name": "phase_one_hot_1",
        "description": "One-hot bit for SUMO phase 1 (yellow A->B). Not seen at deployment (yellow handled by Arduino).",
        "normalization": {
          "type": "one_hot",
          "range": [
            0.0,
            1.0
          ]
        },
        "missing_value": 0.0
      },
      {
        "index": 2,
        "name": "phase_one_hot_2",
        "description": "One-hot bit for SUMO phase 2 (Group B green, dirs 2,3). action 1 maps here, NOT phase 1.",
        "normalization": {
          "type": "one_hot",
          "range": [
            0.0,
            1.0
          ]
        },
        "missing_value": 0.0
      },
      {
        "index": 3,
        "name": "phase_one_hot_3",
        "description": "One-hot bit for SUMO phase 3 (yellow B->A). Not seen at deployment.",
        "normalization": {
          "type": "one_hot",
          "range": [
            0.0,
            1.0
          ]
        },
        "missing_value": 0.0
      },
      {
        "index": 4,
        "name": "green_timer_norm",
        "description": "Time elapsed in current green phase, normalized by max_green_time.",
        "normalization": {
          "type": "clip",
          "range": [
            0.0,
            1.0
          ],
          "formula": "clamp(green_timer_sec / max_green_time, 0, 1)  (max_green_time = 60 s)"
        },
        "missing_value": 0.0
      },
      {
        "index": 5,
        "name": "pressure_norm",
        "description": "Signed phase pressure (schema 1.1.0): 0.5 = balanced; >0.5 = Group A more queued.",
        "normalization": {
          "type": "clip",
          "range": [
            0.0,
            1.0
          ],
          "formula": "clip(0.5 * (1 + mean_q(group_A) - mean_q(group_B)), 0, 1)"
        },
        "notes": "Signed (S2 fix): the policy can tell WHICH group is congested. Was unsigned abs(qa-qb)/4."
      }
    ]
  },
  "temporal_smoothing": {
    "enabled": true,
    "method": "ema",
    "alpha": 0.6,
    "description": "Exponential Moving Average over the full obs vector: new = alpha * current + (1-alpha) * prev. RUNTIME VALUE is read from system_params.temporal_smoothing.buffer_ema_alpha (this block must stay in sync with it).",
    "apply_to": "all_observation_features"
  },
  "roi_association": {
    "primary_method": "polygon_iou",
    "primary_threshold": 0.5,
    "fallback_method": "centroid_inside_polygon",
    "fallback_threshold": null,
    "description": "Primary: compute IoU between detection bbox and lane polygon. If IoU >= 0.5, assign to lane. Fallback: check if detection centroid is inside lane polygon."
  },
  "data_collection": {
    "missing_value_handling": "default_to_zero",
    "nan_handling": "default_to_zero",
    "outlier_clipping": "enabled"
  },
  "training_stability": {
    "observation_normalization": "essential",
    "pressure_range": "[-1, 1]",
    "speed_range": "[0, 1]",
    "occupancy_range": "[0, 1]",
    "notes": "All features must be in valid ranges for stable PPO training"
  },
  "paper_compliance": {
    "lane_based": true,
    "multi_agent": true,
    "bidirectional_pressure": true,
    "temporal_smoothing": true,
    "camera_frame_roi": true,
    "notes": "Configuration suitable for academic publication (Q1/Q2 venues)"
  }
}