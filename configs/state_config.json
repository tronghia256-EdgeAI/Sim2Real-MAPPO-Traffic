        ]
      ],
      "camera_frame": "cam_6_frame"
    },
    "lane_7": {
      "lane_id": "lane_7",
      "tls_id": "tls_1",
      "cam_id": 7,
      "lane_length_px": 180,
      "lane_width_px": 40,
      "polygon": [
        [
